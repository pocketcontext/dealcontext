# Deny everything, then allow only what the Dockerfile copies. .envrc, .env*, pb_data/, .git/,
# tests/, skills/, and any new file stay out of the build context unless they are listed here.
*
!POCKETCONTEXT_VERSION
!pocketcontext.json
!pb_migrations/*.js
!pb_hooks/*.js
!docker/entrypoint.py
!docker/litestream.yml

!ui/
ui/**
!ui/package.json
!ui/pnpm-lock.yaml
!ui/index.html
!ui/tsconfig.json
!ui/vite.config.ts
!ui/src/
!ui/src/**
